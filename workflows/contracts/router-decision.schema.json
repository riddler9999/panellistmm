{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panellistmm.com/contracts/router-decision.schema.json",
  "title": "Panellist Router Decision",
  "description": "Router မှပြန်ရမည့် structured decision. Chain-of-thought သို့မဟုတ် internal free-form reasoning မပါရ.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent",
    "confidence",
    "requires_clarification",
    "missing_information",
    "reason_code",
    "user_prompt"
  ],
  "properties": {
    "intent": {
      "type": "string",
      "enum": [
        "HR_CONSULTATION",
        "SOP_DIAGRAM",
        "ORG_CHART",
        "FORM_TEMPLATE",
        "CLARIFICATION_REQUIRED"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "requires_clarification": {
      "type": "boolean"
    },
    "missing_information": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "subject",
          "hr_issue",
          "description",
          "attachment",
          "sop_scope",
          "org_structure",
          "form_fields",
          "requested_outputs"
        ]
      }
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "CLEAR_SINGLE_INTENT",
        "LOW_CONFIDENCE",
        "MULTI_INTENT",
        "INSUFFICIENT_CONTEXT",
        "UNSUPPORTED_ATTACHMENT",
        "UNSAFE_REQUEST"
      ]
    },
    "user_prompt": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "intent": {
            "const": "CLARIFICATION_REQUIRED"
          }
        }
      },
      "then": {
        "properties": {
          "requires_clarification": {
            "const": true
          },
          "missing_information": {
            "type": "array",
            "minItems": 1
          },
          "user_prompt": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "requires_clarification": {
            "const": false
          },
          "missing_information": {
            "maxItems": 0
          },
          "user_prompt": {
            "type": "null"
          }
        }
      }
    }
  ]
}
