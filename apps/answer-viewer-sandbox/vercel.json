{
  "git": {
    "deploymentEnabled": {
      "feat/pocket-hr-embed-dashboard": false
    }
  },
  "rewrites": [
    {
      "source": "/answer",
      "destination": "/index.html"
    },
    {
      "source": "/answer/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/consultation",
      "destination": "/index.html"
    },
    {
      "source": "/consultation/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/answer/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; font-src 'self' data:; frame-ancestors https:; base-uri 'none'; object-src 'none'; form-action 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/consultation(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; font-src 'self' data:; frame-ancestors https:; base-uri 'none'; object-src 'none'; form-action 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/consultation-maintenance",
      "schedule": "*/5 * * * *"
    }
  ]
}
